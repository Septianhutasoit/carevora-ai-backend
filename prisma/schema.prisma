// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  password       String
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  skills         UserSkill[]
  recommendations Recommendation[]
}

model Skill {
  id           String        @id @default(uuid())
  name         String        @unique
  users        UserSkill[]
  careerSkills CareerSkill[]
}

model UserSkill {
  id      String @id @default(uuid())
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Career {
  id          String        @id @default(uuid())
  title       String        @unique
  description String?
  skills      CareerSkill[]
  recommendations Recommendation[]
}

model CareerSkill {
  id       String @id @default(uuid())
  careerId String
  skillId  String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerId, skillId])
}

model Recommendation {
  id            String   @id @default(uuid())
  userId        String
  careerId      String
  score         Float
  matchedSkills String[] // Menyimpan daftar nama skill yang cocok
  missingSkills String[] // Menyimpan daftar nama skill yang belum dipelajari
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  career        Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
}