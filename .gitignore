# ==========================================
.DS_Store
Thumbs.db
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VSCode settings (Optional, sesuaikan jika ingin menyimpan launch config)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json